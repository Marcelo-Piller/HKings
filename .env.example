# Copie para .env e preencha. O arquivo .env nunca vai para o Git.
#   cp .env.example .env

# ── Obrigatórias em produção ─────────────────────────────────────────────────

# Assina os cookies de sessão. Mínimo de 32 caracteres.
# Gerar:  openssl rand -base64 48
SESSION_SECRET=

# Criptografa os segredos gravados no banco (token do Mercado Pago etc.).
# Precisa ser exatamente 32 bytes em Base64.
# Gerar:  openssl rand -base64 32
SETTINGS_ENCRYPTION_KEY=

# Primeiro administrador. Usados apenas quando ainda não existe nenhum admin.
# A senha precisa de pelo menos 12 caracteres.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ── Mercado Pago ─────────────────────────────────────────────────────────────
# Definidas aqui, têm precedência sobre o que estiver salvo no painel.

# Suas integrações -> Credenciais de produção -> Access Token (começa com APP_USR-).
# Tokens que começam com TEST- são de teste e não cobram de verdade.
MERCADOPAGO_ACCESS_TOKEN=

# Suas integrações -> Webhooks -> chave secreta da notificação.
# Sem ela o webhook é recusado e nenhum pedido é confirmado automaticamente.
MERCADOPAGO_WEBHOOK_SECRET=

# Split de pagamentos (vendedores recebem na própria conta, o site fica com a
# comissão). Suas integrações -> sua aplicação -> Credenciais de produção.
# Também é preciso cadastrar na aplicação a URL de redirecionamento:
#   https://SEU-DOMINIO/vendedor/mercadopago/retorno
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=

# Comprovante por e-mail: senha de app do Gmail (myaccount.google.com/apppasswords).
# A conta que envia e o servidor ficam em Configurações no painel.
SMTP_PASSWORD=

# Login de compradores com Google: chave secreta do cliente OAuth
# (console.cloud.google.com -> APIs e serviços -> Credenciais). O Client ID
# fica em Configurações no painel. URI de redirecionamento a cadastrar:
#   https://SEU-DOMINIO/conta/google/retorno
GOOGLE_CLIENT_SECRET=

# Frete e etiquetas: chave secreta do aplicativo da loja no Melhor Envio
# (Integrações -> Área Dev). Client ID e e-mail de contato ficam no painel.
# URL de redirecionamento a cadastrar:  https://SEU-DOMINIO/melhorenvio/retorno
MELHORENVIO_CLIENT_SECRET=

# ── Opcionais ────────────────────────────────────────────────────────────────

# Notificação de pedido pago pelo WhatsApp (CallMeBot).
WHATSAPP_API_KEY=

# Ligue como "true" somente se houver um proxy reverso à frente sanitizando
# X-Forwarded-For. Ligado sem proxy, permite burlar o limite de tentativas de
# login trocando o cabeçalho. O docker-compose.prod.yml já liga, porque ali o
# Caddy fica na frente.
TRUSTED_PROXY=false

# Livros de exemplo (clássicos em domínio público) numa loja vazia. Em produção
# ficam desligados: seriam vendidos de verdade sem existir no estoque.
SEED_DEMO=false
